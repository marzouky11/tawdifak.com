rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.isAdmin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // نص إلزامي/اختياري بحد أقصى للطول
    function str(field, maxLen) {
      return request.resource.data[field] is string
             && request.resource.data[field].size() <= maxLen;
    }
    function nonEmptyStr(field, maxLen) {
      return str(field, maxLen) && request.resource.data[field].size() > 0;
    }
    function optionalStr(field, maxLen) {
      return !(field in request.resource.data) || str(field, maxLen);
    }

    // عدّاد إحصائيات: إما لم يتغيّر أو تغيّر بمقدار 1 فقط
    function counterStep(field) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([field])
             || request.resource.data[field] == resource.data.get(field, 0) + 1
             || request.resource.data[field] == resource.data.get(field, 0) - 1;
    }

    // قراءة المستخدمين: صاحب الحساب أو المشرف فقط
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin(request.auth.uid));
      allow create: if isAuthenticated() && isOwner(userId)
                    && request.resource.data.isAdmin == false;
      allow update: if isAuthenticated() && (
                      (isOwner(userId) && request.resource.data.isAdmin == resource.data.isAdmin) ||
                      isAdmin(request.auth.uid)
                    );
      allow delete: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // عروض العمل: النشر مقصور على المشرفين فقط
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && isAdmin(request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin(request.auth.uid));
    }

    // باحثون عن عمل: مفتوح لأي مستخدم مسجّل دخوله
    match /workers/{workerId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
                      (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) ||
                      isAdmin(request.auth.uid)
                    );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin(request.auth.uid));
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin(request.auth.uid));
    }

    match /competitions/{compId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /immigration/{postId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /users/{userId}/savedAds/{adId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['adId', 'adUrl', 'reason', 'details', 'createdAt'])
                    && request.resource.data.keys().hasAll(['adId', 'adUrl', 'reason', 'createdAt'])
                    && nonEmptyStr('adId', 100)
                    && nonEmptyStr('adUrl', 500)
                    && nonEmptyStr('reason', 200)
                    && optionalStr('details', 2000)
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
                    && request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
                    && nonEmptyStr('name', 100)
                    && nonEmptyStr('email', 200)
                    && nonEmptyStr('message', 5000)
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /error_logs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'stack', 'url', 'digest', 'createdAt'])
                    && request.resource.data.keys().hasAll(['message', 'createdAt'])
                    && nonEmptyStr('message', 1000)
                    && optionalStr('stack', 10000)
                    && optionalStr('url', 1000)
                    && optionalStr('digest', 100)
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /stats/general {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobs', 'workers', 'users'])
                    && counterStep('jobs')
                    && counterStep('workers')
                    && counterStep('users');
    }
  }
}